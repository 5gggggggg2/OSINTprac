import requests
from bs4 import BeautifulSoup
import time
import random
import logging
import pandas as pd

#Настройка логирования
logger = logging.getLogger("scraper")
logger.setLevel(logging.INFO)
if logger.hasHandlers():
    logger.handlers.clear()
file_handler = logging.FileHandler("scraper.log", encoding="utf-8")
file_handler.setFormatter(logging.Formatter("%(asctime)s — %(levelname)s — %(message)s"))
logger.addHandler(file_handler)

HEADERS = {
    "User-Agent": "Mozilla/5.0 (student scraper, practice 2)"
}

BASE_URL = "https://books.toscrape.com/catalogue/page-{}.html"
MAX_PAGES = 50
MIN_DELAY = 1
MAX_DELAY = 2
MAX_RETRIES = 3

all_books = []

def fetch_page(url, retries=MAX_RETRIES):
    for attempt in range(1, retries + 1):
        try:
            resp = requests.get(url, headers=HEADERS, timeout=10)
            resp.encoding = "utf-8"
            if resp.status_code == 200:
                return resp
            logger.warning(f"Попытка {attempt}: статус {resp.status_code} для {url}")
        except requests.exceptions.RequestException as e:
            logger.warning(f"Попытка {attempt}: сетевая ошибка — {e}")
        time.sleep(2 ** attempt)
    logger.error(f"Не удалось загрузить {url} после {retries} попыток")
    return None

for page in range(1, MAX_PAGES + 1):
    url = BASE_URL.format(page)
    print(f"Обрабатываю страницу {page}")
    logger.info(f"Начало обработки страницы {page}: {url}")

    resp = fetch_page(url)
    if resp is None:
        print(f"  Пропуск страницы {page}")
        continue

    soup = BeautifulSoup(resp.text, "html.parser")
    cards = soup.select("article.product_pod")

    if not cards:
        logger.info(f"Страница {page}: записей нет — остановка")
        break

    for card in cards:
        try:
            title = card.select_one("h3 > a")["title"]
            price = card.select_one("p.price_color").text.strip()
            rating_class = card.select_one("p.star-rating")["class"]
            rating = rating_class[1] if len(rating_class) > 1 else "Unknown"
            availability = card.select_one("p.instock.availability").text.strip()
            link = card.select_one("h3 > a")["href"]

            all_books.append({
                "title": title,
                "price": price,
                "rating": rating,
                "availability": availability,
                "link": link
            })
        except Exception as e:
            logger.warning(f"Ошибка парсинга карточки на стр. {page}: {e}")

    print(f"  Собрано: {len(cards)} записей")
    logger.info(f"Страница {page}: собрано {len(cards)} записей")
    time.sleep(random.uniform(MIN_DELAY, MAX_DELAY))

df = pd.DataFrame(all_books)
df.to_csv("books_dataset.csv", index=False, encoding="utf-8-sig")

print(f"\nВсего собрано записей: {len(all_books)}")
print(f"Датасет сохранён: books_dataset.csv")
print(f"Строк: {len(df)}, столбцов: {len(df.columns)}")
print(f"\nПропусков по полям:")
print(df.isnull().sum())

logger.info(f"Сбор завершён. Всего записей: {len(all_books)}")

